{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": ["esnext"],
    "sourceMap": true,
    "declaration": true  ,  
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true

  },
  "include": ["src/**/*.ts"]
}